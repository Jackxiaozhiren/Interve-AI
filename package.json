{
  "name": "interve-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "e2e:install-browser": "playwright install --with-deps chromium",
    "test:e2e:mock": "E2E_MOCK=1 playwright test --project=chrome-1280x720 tests/mock-journey.spec.ts tests/chat.spec.ts",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "test:eval:free": "vitest run --config vitest.eval.config.ts evals/free.eval.test.ts",
    "verify:supabase-free": "node scripts/verify-supabase-free.mjs",
    "quota": "node scripts/quota-ledger.mjs status",
    "facts": "node scripts/audit-facts.mjs --write",
    "facts:check": "node scripts/audit-facts.mjs --check",
    "falsify": "node scripts/falsify/guards.mjs",
    "falsify:all": "node scripts/falsify/guards.mjs --slow",
    "audit:deps": "sh scripts/audit-deps.sh",
    "facts:seed": "node scripts/audit-facts.mjs --seed",
    "test:e2e:smoke": "playwright test --project=chrome-1280x720 tests/landing.spec.ts tests/setup.spec.ts tests/interview.spec.ts tests/interview-flow.spec.ts tests/dashboard.spec.ts tests/replay.spec.ts tests/settings.spec.ts tests/accessibility.spec.ts tests/chat.spec.ts tests/privacy.spec.ts tests/clipboard-disclosure.spec.ts tests/selection-a11y.spec.ts tests/e2e/interview-greenroom.spec.ts tests/e2e/interview-interactive.spec.ts tests/e2e/dashboard-average-card.spec.ts",
    "test:e2e:axe": "playwright test --project=chrome-1280x720 --grep-invert \"Visual regression\" tests/a11y-visual.spec.ts",
    "test:e2e:visual": "playwright test --project=chrome-1280x720 --grep \"Visual regression\" tests/a11y-visual.spec.ts",
    "visual:baselines": "playwright test --project=chrome-1280x720 --grep \"Visual regression\" --update-snapshots=all tests/a11y-visual.spec.ts",
    "test:e2e:keyboard": "playwright test --project=chrome-1280x720 --grep-invert \"keyboard-operable\" tests/keyboard.spec.ts",
    "test:a11y": "playwright test --project=chrome-1280x720 tests/accessibility.spec.ts",
    "perf:assert": "node scripts/perf-probe.mjs --assert",
    "verify": "npm run facts:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.80",
    "@ai-sdk/openai": "^4.0.75",
    "@ai-sdk/react": "^4.0.117",
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@orama/orama": "^3.1.18",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.117.1",
    "@tldraw/tldraw": "^4.5.10",
    "ai": "^7.0.111",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.48.0",
    "mermaid": "^11.14.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldraw": "^4.5.10",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.59.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
}
