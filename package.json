{
  "name": "interve-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:mock": "E2E_MOCK=1 playwright test --project=chrome-1280x720 tests/mock-journey.spec.ts",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "test:eval:free": "vitest run --config vitest.eval.config.ts evals/free.eval.test.ts",
    "verify:supabase-free": "node scripts/verify-supabase-free.mjs",
    "quota": "node scripts/quota-ledger.mjs status",
    "test:e2e:smoke": "playwright test --project=chrome-1280x720 tests/landing.spec.ts tests/setup.spec.ts tests/interview.spec.ts tests/interview-flow.spec.ts tests/dashboard.spec.ts tests/replay.spec.ts tests/settings.spec.ts tests/accessibility.spec.ts tests/chat.spec.ts",
    "test:a11y": "playwright test --project=chrome-1280x720 tests/accessibility.spec.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.170",
    "@base-ui/react": "^1.8.0",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@huggingface/transformers": "^4.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@orama/orama": "^3.1.18",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.116.0",
    "@tldraw/tldraw": "^4.5.10",
    "@types/canvas-confetti": "^1.9.0",
    "ai": "^6.0.168",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^1.46.0",
    "mermaid": "^11.14.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tldraw": "^4.5.10",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
