# ==============================================
# Interve AI - Environment Variables (ALL FREE, $0)
# ==============================================
# Copy this file to .env.local and fill in the values.
# Nothing here costs money. Keyless defaults work for dev/test/build.
#
# --- Zhipu AI (智谱 AI) --- FREE tier, required for live AI features
# Free registration: https://open.bigmodel.cn/ → API Keys → new key.
# Free allowance covers daily practice + the ≤3-call eval smoke.
# Without it: pages/tests/build still pass; AI routes return 401/503-safe
# errors and `AI_MOCK=1` exercises handlers schema-deep with zero keys.
ZHIPU_API_KEY=your_zhipu_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# --- OpenAI (Optional, NOT needed) --- Leave blank for the free stack
# Only used when explicitly passing ?model=openai. Free tiers never call it.
OPENAI_API_KEY=

# --- OpenRouter (Optional, FREE :free models) --- Opt-in third lane
# Free: https://openrouter.ai/ → Keys → new key. Server-only, never
# NEXT_PUBLIC_*. Only used when explicitly passing ?model=openrouter
# (Nemotron Ultra free-form chat) or ?model=openrouter-structured
# (DeepSeek structured-output candidate). Never the default: free models
# rotate + rate-limit. Without it: opt-in calls fail closed, everything
# else still passes keyless.
OPENROUTER_API_KEY=
# Optional: Referer header sent to OpenRouter (analytics/rankings only).
OPENROUTER_SITE_URL=

# --- Session (Phase 2) --- Required in production for signed auth cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dev without it uses an insecure deterministic fallback (local only, never production).
SESSION_SECRET=your_64_hex_char_secret_here

# --- Supabase (Optional, FREE tier) --- For persistent data storage
# Free: https://supabase.com/ → New project (Free plan) → SQL Editor →
# paste supabase/migrations/001_init_schema.sql then 002_session_ownership.sql
# → Project Settings → API → copy URL + anon key (never service_role).
# Without it: app runs on the local fallback (local-<uuid> sessions).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
