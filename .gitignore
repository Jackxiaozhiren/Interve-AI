# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Dev artifacts & test data
/artifacts/
/scratch/
test-output.txt
dummy_resume.pdf

# AI tooling
CLAUDE.md
task.md
implementation_plan.md

.vercel

# dsa-web: independent Next app, explicitly NOT merged into npm workspaces
# (Next 16.3 + Tailwind 3.4 vs root Next 16.2 + Tailwind v4; separate deploys)
apps/dsa-web/.next/
apps/dsa-web/test-results/
apps/dsa-web/playwright-report/

# dsa-api: standalone FastAPI service
services/dsa-api/.venv/
__pycache__/

# supabase CLI local state (project-ref, pooler-url, versions) — never commit
/supabase/.temp/

# rater-pack generator output (synthetic blind packs + human score sheets)
# Regenerate with: node scripts/rater-pack.mjs (see EVAL_REPORT §6)
/rater-pack/

# Phase C1 quota ledger (local per-machine call counts, zero secrets).
# Regenerated automatically; inspect with: npm run quota
/.quota-ledger.json

# V11 Phase 0 audit snapshot: a per-run derivative of git state + timestamps,
# so committing it would diff on every `npm run facts`. The durable artifact is
# the sibling facts.limits.json (reviewed policy ceilings), which IS tracked.
# Regenerate with: npm run facts
/docs/audit/facts.baseline.json
